aws_region = "us-east-1"
demo_account_id = "123456789012"
bucket_prefix = "owner-unique-prefix"
github_repository = "tdinh-dev-sec-scientist/Vorrin"
github_image_environment = "phase3-scan-image"
enable_scan_pipeline = false
scan_container_image = ""
scan_schedule_enabled = false
enable_stage2 = false
enable_stage3 = false
enable_stage4 = false
# invite_only (default): Cognito sign-in with MFA for live data and Rin. public: anonymous read-only API with WAF.
access_mode           = "invite_only"
cognito_domain_prefix = "owner-unique-console-prefix"
# WAF defaults to off in invite_only mode; API Gateway throttling always applies.
# enable_waf               = false
# api_throttle_rate_limit  = 2
# api_throttle_burst_limit = 10
rin_enabled = false
# Keep Rin disabled until the owner confirms provider rates/budgets and publishes a Bedrock Guardrail.
rin_guardrail_arn     = ""
rin_guardrail_version = ""
# Set monthly/provider budgets and provider inputs only after the owner confirms them.
