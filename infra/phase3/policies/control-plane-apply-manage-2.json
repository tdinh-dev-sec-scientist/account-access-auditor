{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageOnlyPrefixedTopicsAndAlarms",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:TagResource",
        "sns:UntagResource",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource"
      ],
      "Resource": [
        "arn:aws:sns:${region}:${account_id}:${bucket_prefix}-p3-*",
        "arn:aws:sns:${region}:${account_id}:${bucket_prefix}-phase3-*",
        "arn:aws:cloudwatch:${region}:${account_id}:alarm:${bucket_prefix}-p3-*"
      ]
    },
    {
      "Sid": "ManageSubscriptionsWhichHaveGeneratedArns",
      "Effect": "Allow",
      "Action": [
        "sns:Unsubscribe",
        "sns:SetSubscriptionAttributes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageOnlyPrefixedSecretContainers",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:UpdateSecret",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource",
        "secretsmanager:PutResourcePolicy",
        "secretsmanager:DeleteResourcePolicy"
      ],
      "Resource": "arn:aws:secretsmanager:${region}:${account_id}:secret:${bucket_prefix}/phase3/*"
    },
    {
      "Sid": "ManageOnlyPrefixedBudgets",
      "Effect": "Allow",
      "Action": [
        "budgets:ModifyBudget",
        "budgets:TagResource",
        "budgets:UntagResource"
      ],
      "Resource": "arn:aws:budgets::${account_id}:budget/${bucket_prefix}-phase3-*"
    },
    {
      "Sid": "ManageApiGatewayRestApis",
      "Effect": "Allow",
      "Action": [
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:${region}::/restapis",
        "arn:aws:apigateway:${region}::/restapis/*",
        "arn:aws:apigateway:${region}::/tags/*"
      ]
    },
    {
      "Sid": "ManagePrefixedWebAcls",
      "Effect": "Allow",
      "Action": [
        "wafv2:CreateWebACL",
        "wafv2:UpdateWebACL",
        "wafv2:DeleteWebACL",
        "wafv2:AssociateWebACL",
        "wafv2:DisassociateWebACL",
        "wafv2:TagResource",
        "wafv2:UntagResource",
        "apigateway:SetWebACL",
        "cloudfront:UpdateDistribution"
      ],
      "Resource": [
        "arn:aws:wafv2:*:${account_id}:*/webacl/${bucket_prefix}-p3-*/*",
        "arn:aws:apigateway:${region}::/restapis/*/stages/*",
        "arn:aws:cloudfront::${account_id}:distribution/*"
      ]
    },
    {
      "Sid": "ManageCloudFrontWhichHasGeneratedIds",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateDistribution",
        "cloudfront:CreateDistributionWithTags",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:TagResource",
        "cloudfront:UntagResource",
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl",
        "cloudfront:CreateCachePolicy",
        "cloudfront:UpdateCachePolicy",
        "cloudfront:DeleteCachePolicy",
        "cloudfront:CreateOriginRequestPolicy",
        "cloudfront:UpdateOriginRequestPolicy",
        "cloudfront:DeleteOriginRequestPolicy",
        "cloudfront:CreateResponseHeadersPolicy",
        "cloudfront:UpdateResponseHeadersPolicy",
        "cloudfront:DeleteResponseHeadersPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageCognitoPoolsWhichHaveGeneratedIds",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPool",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:CreateUserPoolDomain",
        "cognito-idp:UpdateUserPoolDomain",
        "cognito-idp:DeleteUserPoolDomain",
        "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageTheScanNetworkWhichHasGeneratedIds",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:DeleteVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:CreateSubnet",
        "ec2:DeleteSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:CreateInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:CreateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:ReplaceRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*"
    }
  ]
}
