{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyTheProtectedPhase3TerraformJob",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::${account_id}:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:${github_subject_repository}:environment:${github_environment}",
          "token.actions.githubusercontent.com:workflow": "Phase 3 Terraform",
          "token.actions.githubusercontent.com:ref": "refs/heads/main"
        }
      }
    }
  ]
}
