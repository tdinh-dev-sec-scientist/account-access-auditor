{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AWS Account & Access Auditor Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_id",
    "scanner",
    "scanner_rule_id",
    "source_type",
    "resource_reference",
    "source_location",
    "severity",
    "title",
    "description",
    "evidence",
    "remediation",
    "references",
    "fingerprint",
    "lifecycle_state",
    "detected_at",
    "run_id"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "control_id": { "type": "string", "minLength": 1 },
    "scanner": { "type": "string", "minLength": 1 },
    "scanner_rule_id": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "minLength": 1 },
    "account_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": { "const": "aws" },
        "id": { "type": "string", "pattern": "^[0-9]{12}$" }
      }
    },
    "region": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "minLength": 1 },
    "resource_reference": { "type": ["string", "null"] },
    "source_location": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
    "source_severity": { "type": ["string", "null"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "evidence": { "type": "object" },
    "remediation": { "type": "string" },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "framework", "id"],
        "properties": {
          "type": { "const": "compliance" },
          "framework": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" }
        }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "lifecycle_state": {
      "enum": ["open", "new", "persistent", "changed", "resolved", "unknown", "error"]
    },
    "detected_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": ["string", "null"] },
    "gate": { "type": "boolean" },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "reason", "expires_at", "state"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "approver": { "type": ["string", "null"] },
          "reason": { "type": "string", "minLength": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "state": { "enum": ["ACTIVE", "EXPIRED"] }
        },
        "additionalProperties": false
      }
    }
  }
}
