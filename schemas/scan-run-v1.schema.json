{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AWS Account & Access Auditor Scan Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scan_source",
    "commit_ref",
    "workflow_ref",
    "account_refs",
    "regions",
    "scanner_versions",
    "policy_pack_version",
    "started_at",
    "completed_at",
    "status",
    "gate_status",
    "exit_code",
    "finding_count",
    "collection_error_count"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "scan_source": { "type": "string", "minLength": 1 },
    "commit_ref": { "type": ["string", "null"] },
    "workflow_ref": { "type": ["string", "null"] },
    "account_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "id"],
        "properties": {
          "provider": { "const": "aws" },
          "id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "scanner_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "policy_pack_version": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL", "UNKNOWN", "ERROR"] },
    "gate_status": { "enum": ["NOT_CONFIGURED", "PASS", "FAIL"] },
    "exit_code": { "enum": [0, 1, 2, 3] },
    "finding_count": { "type": "integer", "minimum": 0 },
    "collection_error_count": { "type": "integer", "minimum": 0 },
    "gate_threshold": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] }
  }
}
