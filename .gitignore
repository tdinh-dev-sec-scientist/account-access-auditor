# Credentials -- never commit these
.env
.env.*
.aws/
credentials
*.pem
*.key

# Terraform working data and owner-specific values can contain account IDs,
# e-mail addresses, role ARNs, external IDs, and infrastructure state.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# Scan output. May contain real account identifiers, usernames, and bucket
# names. The committed evidence under results/ comes from the emulated lab
# account and is written with access key IDs masked.
reports/

# The published site is built from results/ by scripts/build_site.py.
site/

# Coverage's raw JSON is regenerated by every run and is large.
results/coverage.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.eggs/
*.egg-info/
build/
dist/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
~$*.docx

# Raw AWS role captures contain account-specific policy data; only redacted
# projections and reviewed digests belong in tracked evidence.
docs/evidence/.private-role-captures/
